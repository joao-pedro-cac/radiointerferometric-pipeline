# Copy to scripts/env.sh (gitignored). Source order: env.sh first, then
# scripts/paths.sh fills in auto-detected defaults — so only set what you want
# to OVERRIDE. Paths (CODE_ROOT/STAGE_ROOT/VENV_PATH/DATASET_PATH/RESULTS_PATH/
# UVCOV/OSKAR_SIF/TELESCOPE_DIR/PFB_DIR) are auto-detected for both trees:
#   local : <archive>/code/... with <archive>/{data,lib}
#   remote: flattened repo root with {data,lib,venv,results}/ at the root
# Default venv is in-tree: <repo>/venv (created by `bash setup_env.sh`).

# --- simulation mode -------------------------------------------------------
# export SIM_MODE="ducc0"   # "ducc0" (fast, default) or "oskar" (canonical; needs singularity)
# OSKAR mode (SIM_MODE=oskar) — mandatory singularity route:
# export SINGULARITY="singularity"                        # binary on PATH
# export OSKAR_SIF="$STAGE_ROOT/lib/OSKAR-2.12.2-Python3.sif"
# export TELESCOPE_DIR="$STAGE_ROOT/data/oskar/telescopes"
# export TELESCOPE="meerkat.tm"

# --- batch-2 launchers ------------------------------------------------------
export NOISE_SEEDS="101 102"   # visibility-noise seeds
export MAXJOBS=8               # concurrent runs (run_experiment.sh) / dataset builds

# --- optional explicit overrides (rarely needed) ----------------------------
# export VENV_PATH="$PWD/venv"
# export DATASET_PATH="$STAGE_ROOT/data/simulated/v2"
# export RESULTS_PATH="$CODE_ROOT/results"
