# Copy to scripts/env.sh (gitignored) and fill in local paths.
# All root-level pipeline scripts (setup_env.sh, simulate_data.sh,
# run_experiment.sh) source this file when present.
export STAGE_ROOT="/Users/mhiriy/work/responsabilités/encadrements/archive/2026_stage-joao"
export VENV_PATH="/tmp/joao-venv"                 # created by setup_env.sh
export DATASET_PATH="$STAGE_ROOT/data/simulated/v2"
export RESULTS_PATH="$STAGE_ROOT/code/results"
export UVCOV="$STAGE_ROOT/data/uvcov/meerkat_1h_4ch_1p4ghz.npz"

# --- simulation mode -------------------------------------------------------
export SIM_MODE="ducc0"     # "ducc0" (fast) or "oskar" (canonical, needs singularity)
# OSKAR mode (SIM_MODE=oskar) — mandatory singularity route:
export SINGULARITY="singularity"                                   # binary on PATH
export OSKAR_SIF="$STAGE_ROOT/lib/OSKAR-2.12.2-Python3.sif"        # OSKAR image
export TELESCOPE_DIR="$STAGE_ROOT/data/oskar/telescopes"           # .tm layouts
export TELESCOPE="meerkat.tm"                                      # layout file

# --- batch-2 launchers ------------------------------------------------------
export NOISE_SEEDS="101 102"   # visibility-noise seeds
export MAXJOBS=8               # concurrent CLEAN runs (run_experiment.sh) / dataset builds
